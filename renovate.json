{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:org-inherited-config",
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:automerge",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:go"
  ],
  "semanticCommits": "auto",
  "packageRules": [
    {
      "description": "Automerge major updates of GitHub's own actions too: ci.yml runs actions/checkout and actions/setup-go, so a green ci-ok exercises the new major. A group of their own keeps a third-party major, which waits for a review, from holding them back.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*",
        "github/*"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major GitHub-owned Actions",
      "automerge": true
    }
  ]
}
